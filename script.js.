document.addEventListener("DOMContentLoaded", function () {

    // MENU
    const botaoMenu = document.getElementById("botao-menu");
    const menu = document.getElementById("menu");

    if (botaoMenu && menu) {
        botaoMenu.addEventListener("click", function () {
            menu.hidden = !menu.hidden;

            botaoMenu.setAttribute(
                "aria-expanded",
                !menu.hidden
            );
        });
    }

    // PRODUTOS
    document.querySelectorAll(".ver-produtos").forEach(function (botao) {
        const lista = botao.nextElementSibling;

        botao.addEventListener("click", function () {
            lista.hidden = !lista.hidden;

            botao.textContent = lista.hidden
                ? "Ver produtos"
                : "Ocultar produtos";
        });
    });

    // PERGUNTAS FREQUENTES
    document.querySelectorAll(".pergunta").forEach(function (pergunta) {
        const resposta = pergunta.nextElementSibling;

        pergunta.addEventListener("click", function () {
            resposta.hidden = !resposta.hidden;

            pergunta.setAttribute(
                "aria-expanded",
                !resposta.hidden
            );
        });
    });

});
