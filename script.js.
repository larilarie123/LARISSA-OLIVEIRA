document.addEventListener("DOMContentLoaded", function () {

    // MENU INTERATIVO
    const botaoMenu = document.getElementById("botao-menu");
    const menu = document.getElementById("menu");

    if (botaoMenu && menu) {
        menu.hidden = true;

        botaoMenu.addEventListener("click", function () {
            menu.hidden = !menu.hidden;

            botaoMenu.setAttribute(
                "aria-expanded",
                !menu.hidden
            );
        });
    }

    // PRODUTOS ESSENCIAIS
    const botoesProdutos = document.querySelectorAll(".ver-produtos");

    botoesProdutos.forEach(function (botao) {
        const lista = botao.nextElementSibling;

        if (lista) {
            lista.hidden = true;

            botao.addEventListener("click", function () {
                lista.hidden = !lista.hidden;

                botao.textContent = lista.hidden
                    ? "Ver produtos"
                    : "Ocultar produtos";
            });
        }
    });

    // PERGUNTAS FREQUENTES
    const perguntas = document.querySelectorAll(".pergunta");

    perguntas.forEach(function (pergunta) {
        const resposta = pergunta.nextElementSibling;

        if (resposta) {
            resposta.hidden = true;

            pergunta.setAttribute("aria-expanded", "false");

            pergunta.addEventListener("click", function () {
                resposta.hidden = !resposta.hidden;

                pergunta.setAttribute(
                    "aria-expanded",
                    !resposta.hidden
                );
            });
        }
    });

});

