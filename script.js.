// Seleciona os cards usando a classe exata do seu HTML
const cards = document.querySelectorAll('.cartao-make');

cards.forEach(card => {
  // Quando o mouse ou o dedo entra no card
  card.addEventListener('mouseenter', () => {
    card.classList.add('card-ativo');
  });

  // Quando o mouse ou o dedo sai do card
  card.addEventListener('mouseleave', () => {
    card.classList.remove('card-ativo');
  });
});
